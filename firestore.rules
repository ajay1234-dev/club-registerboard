rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Student / Public Rules ──────────────────────────────────────────────

    // Anyone can read event settings and active clubs (for the registration form and leaderboard)
    match /settings/event {
      allow read: if true;
    }

    match /clubs/{clubId} {
      allow read: if true;
      // Writes are strictly denied. Counts are updated via server-side Admin SDK transaction.
    }

    // ── Server-Side Only Rules ──────────────────────────────────────────────

    // Students NEVER write directly to these collections. 
    // All writes happen through the Next.js API using the Admin SDK, which bypasses these rules.
    match /registrations/{registrationId} {
      allow read, write: if false;
    }

    match /deviceRegistrations/{deviceId} {
      allow read, write: if false;
    }

    match /emailRegistrations/{emailId} {
      allow read, write: if false;
    }
  }
}
